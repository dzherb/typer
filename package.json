{
  "name": "typer",
  "private": true,
  "version": "0.3.3",
  "description": "A minimal markdown editor for daily notes, kept as .md files in a folder on disk.",
  "license": "MIT",
  "homepage": "https://typer.dzherb.ru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzherb/typer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "biome check . && eslint .",
    "format": "biome check --write .",
    "check": "tsc && bun run lint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "eslint": "^10.10.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2"
  }
}
